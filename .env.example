# Copy to .env and fill in. NEVER commit .env.
# .env is gitignored and excluded from the transfer bundle by design.

# Anthropic — for the LLM scoring stages (meanness, stance)
ANTHROPIC_API_KEY=

# HuggingFace — REQUIRED for pyannote diarization.
#   Create the token here:  https://huggingface.co/settings/tokens
#   ("Read" scope is enough.)
#
# Accept the model's user conditions signed in as the SAME account the token
# belongs to. WhisperX 3.8.x requires pyannote-audio >= 4, so the model is:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
# (The older pair — speaker-diarization-3.1 + segmentation-3.0 — only matters if
# you pin an older WhisperX. Accepting them too costs nothing.)
# Miss this and you get an unhelpful 401 deep in a stack trace, on a rented GPU,
# with the meter running.
#
# Verify BEFORE renting a GPU — this checks the token AND the licence:
#   make creds          (scripts/check_credentials.py)
HF_TOKEN=

# RunPod — pod lifecycle is the REST/GraphQL API, not SSH
#   Sign up:  https://www.runpod.io/console/signup
#   API key:  https://www.runpod.io/console/user/settings  (Settings -> API Keys)
#   Console:  https://www.runpod.io/console/pods
# Credit-based, not post-paid: add a balance before Phase 0. $10 is plenty.
RUNPOD_API_KEY=

# Notifications. The pipeline calls a single notify(level, message)
# (pipeline/notify.py); the backend is swappable. Default: WhatsApp through the
# OpenClaw gateway on the supervisor Mac (DECISIONS.md #7).
NOTIFY_BACKEND=openclaw          # openclaw | discord | none

# Where OpenClaw sends it. TARGET is Puck's number in E.164 form (+15551234567);
# it is the one setting without which nothing reaches the phone.
OPENCLAW_NOTIFY_CHANNEL=whatsapp
OPENCLAW_NOTIFY_TARGET=
# OPENCLAW_BIN=openclaw          # if the CLI is not on PATH for the worker user

# Discord (only if NOTIFY_BACKEND=discord)
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_URL=

# Guardrail: refuse to rent a GPU past this cumulative monthly spend. The check
# is code-level (plan/SCHEMA.md `spend`), not a prompt. The real ceiling is the
# RunPod prepaid balance — keep that small as well.
MONTHLY_SPEND_CAP_USD=150

# Propose a GPU batch once this many capped audio-hours are ready. Below ~2 GPU
# hours of work, pod boot and model download dominate the bill (PLAN.md §2).
# 50 -> 15 on 2026-09-22 (T2): at the measured 25x RTFX and $0.49/h an A40
# chews 15 audio-h in 36 min, so ~7 min of boot is a sixth of the bill rather
# than a third; and T2's located episode-hours are running far below the §3
# projection, so a 50-h threshold meant no batch was ever proposable.
BATCH_TARGET_HOURS=15

# GPU pod (pipeline/gpu_job.py, PLAN.md 4.5). Defaults are in gpu_job.POD_DEFAULTS
# and gpu_batch.cfg(); set here only to override. ALL of these are unverified
# until the first pod has run -- the first launch is where they get corrected.
#   GPU_USD_PER_HOUR=0.34          RTX 4090 community tier; used for estimates AND actual spend
#   GPU_RTFX_ESTIMATE=25           audio-seconds per GPU-second; replace with the measured value
#   GPU_BOOT_MINUTES=7             paid boot + model download, for the estimate
#   GPU_IMAGE=runpod/pytorch:2.8.0-py3.11-cuda12.8.1-cudnn-devel-ubuntu22.04
#   GPU_TYPE_ID=NVIDIA GeForce RTX 4090
#   GPU_CLOUD_TYPE=COMMUNITY       SECURE if community machines keep lacking a public IP
#   GPU_SSH_KEY=~/.ssh/ytpt_runpod ed25519 keypair used only for pods (ssh-keygen -t ed25519 -N '' -f ...)
#   GPU_JOB_TIMEOUT_MIN=           empty = computed from the batch's audio hours, max 12 h
#   BATCH_DIR=output/batches       manifests, pulled transcripts (QA FAILs stay here), pod logs
#   WHISPER_DIR=output/whisper     where QA-passed transcripts land

# Transcribe at most this many minutes per video (SAMPLING.md). Must match what
# build_frame.py drew with, or the dashboard's targets and the pipeline disagree.
TRANSCRIBE_CAP_MIN=45

# Warn when no download has finished for this many hours.
STALL_HOURS=6

# Local dashboard (loopback only): http://localhost:8765
DASHBOARD_PORT=8765

# LLM scoring model for meanness/stance. Pin one model for a whole measurement;
# results are comparable only within one model AND one prompt version
# (docs/MODELS.md). Claude 5 models reject a non-default temperature.
SCORING_MODEL=claude-sonnet-4-6

# Where state.sqlite lives. MUST be real local disk — not a synced folder,
# network mount, iCloud or Dropbox. SQLite needs locking those don't provide.
STATE_DB_PATH=~/.local/share/ytpt/state.sqlite

# Backblaze B2 backup (optional). Bucket name must be globally unique.
# Put the Application Key here and backup.sh hands it to rclone via environment
# variables — no `rclone config` needed, and only one copy of the secret.
#   Console -> Application Keys -> Add a New Application Key, scoped to the one
#   bucket, read+write. The applicationKey is shown ONCE.
B2_BUCKET=
B2_KEY_ID=                # the keyID from the console
                          # (B2_ACCOUNT_ID also accepted — same thing;
                          #  B2 calls it keyID in the UI, account in the API)
B2_APPLICATION_KEY=
B2_REMOTE=b2
